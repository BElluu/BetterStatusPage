# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# Docker Compose image to run.
BSP_IMAGE=ghcr.io/belluu/better-status-page:latest

# Bind to localhost when running behind Nginx. Use 0.0.0.0 only for direct testing.
BSP_BIND_ADDRESS=127.0.0.1

# ── Security (REQUIRED in production) ────────────────────────────────────────
# Random string, min 32 chars — used to sign JWT tokens
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# 64-char hex string (32 bytes) — used to encrypt vault secrets with AES-256-GCM
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: if this changes, all stored vault secrets become unreadable
VAULT_ENCRYPTION_KEY=change-me-to-a-64-char-hex-string

# ── First-run setup ───────────────────────────────────────────────────────────
# The web setup wizard asks for the first administrator credentials.
# Set these only when intentionally running `npm run db:seed`.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-with-a-strong-password

# ── Storage ───────────────────────────────────────────────────────────────────
# Path to the SQLite database file
DATABASE_PATH=./data/db.sqlite
# Path where uploaded files (logos, favicons) are stored
UPLOAD_DIR=./data/uploads

# ── CORS (optional) ───────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Leave unset to allow all in dev,
# or to let Nginx handle CORS in production.
# ALLOWED_ORIGINS=https://status.example.com,https://admin.example.com

# Trust the nearest reverse proxy when the application port is not publicly exposed.
# Required for per-client rate limits behind Nginx. Keep disabled for direct exposure.
# 1 = trust a proxy on loopback or a private network (e.g. a Docker bridge); or list addresses/CIDRs.
# TRUST_PROXY=1

# Session cookies are Secure in production, which a browser keeps only over HTTPS (or on localhost).
# Set to false when the panel is opened over plain http:// on a trusted network or VPN. Passwords and sessions
# then travel unencrypted; on the internet put HTTPS in front instead.
# COOKIE_SECURE=false

# ── Scheduler (optional) ───────────────────────────────────────────────────────
# How often the scheduler looks for monitors that are due. Monitor frequency is
# still controlled per monitor by intervalSecs. Must be 1-59 seconds.
# SCHEDULER_TICK_SECONDS=10

# How many due monitors can be checked concurrently.
# MONITOR_CHECK_CONCURRENCY=20
# How many monitors one API token may create per hour by sending a heartbeat to a new key
# (/api/v1/hook/key/<key>). 0 = no limit.
# HEARTBEAT_AUTO_CREATE_LIMIT=50

# How long monitor result history is retained.
# MONITOR_RESULT_RETENTION_DAYS=90

# Cron expression for purging old monitor results. Default: daily at 02:00.
# MONITOR_RESULT_PURGE_CRON=0 2 * * *

# ── Status page subscriptions (optional) ──────────────────────────────────────
# Public URL of the status page. Every link in subscriber emails (confirm, manage,
# unsubscribe) and in Slack, feeds and the status API is built from it. Email and
# webhook subscriptions are unavailable until it is set. Kept out of the admin
# console on purpose: changing where those links point needs server access. An SSO
# sign-in started on a private status page's sign-in screen returns to it as well.
# PUBLIC_URL=https://status.example.com

# Allow subscriber webhooks to reach private/internal addresses (and plain http).
# Leave unset on internet-facing pages — visitors choose these URLs.
# SUBSCRIBER_WEBHOOK_ALLOW_PRIVATE=true

# Monitors, tests and HTTP actions refuse cloud metadata addresses (169.254.0.0/16, fe80::/10, fd00:ec2::254,
# fd20:ce::254, 100.100.100.200, metadata.google.internal). Private networks stay reachable. Set to true only on a
# host where a monitor has to read a metadata service.
# MONITOR_ALLOW_METADATA=true

# Send HTTPS monitor checks (and the Test button) through an outbound proxy. NO_PROXY lists hosts reached directly.
# HTTP_PROXY=http://proxy.example:3128
# HTTPS_PROXY=http://proxy.example:3128
# NO_PROXY=localhost,127.0.0.1,.internal.example

# ── Update check (optional) ───────────────────────────────────────────────────
# The server asks GitHub (api.github.com) for the latest release, at most once
# every 6 hours, and links to it when it is newer than the running version.
# Set to false to stop the server from making that request.
# UPDATE_CHECK=false
