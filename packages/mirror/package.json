{
  "name": "@better-kit/mirror",
  "version": "0.1.0",
  "description": "Publishes a set of files to static hosting: S3-compatible storage transport, change detection and a single-flight interval runner.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^5.7.3"
  }
}
