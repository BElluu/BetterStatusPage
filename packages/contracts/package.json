{
  "name": "@better-forge/contracts",
  "version": "0.1.0",
  "description": "Browser-safe types, core translations and a storage wrapper that never throws.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BElluu/Better-Forge.git",
    "directory": "packages/contracts"
  },
  "homepage": "https://github.com/BElluu/Better-Forge/tree/main/packages/contracts#readme",
  "bugs": {
    "url": "https://github.com/BElluu/Better-Forge/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=26.10.0"
  }
}
