{
  "name": "@better-forge/ui",
  "version": "0.1.0",
  "description": "React admin shell, UI components, API client and shared pages.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
