    "./tailwind-preset": "./tailwind-preset.js"
  },
  "files": [
    "dist",
    "styles",
    "tailwind-preset.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput"
  },
  "peerDependencies": {
    "@better-forge/contracts": "^0.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "clsx": "^2.1.1",
    "react-router-dom": "^7.5.0",
    "@tanstack/react-query": "^5.74.4"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "clsx": "^2.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.5.0",
    "@tanstack/react-query": "^5.74.4"
  },
  "sideEffects": [
    "*.css"
  ]
}
