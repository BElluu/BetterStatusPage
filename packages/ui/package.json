{
  "name": "@better-forge/ui",
  "version": "0.1.0",
  "description": "React admin shell, UI components, API client and shared pages.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BElluu/Better-Forge.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/BElluu/Better-Forge/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/BElluu/Better-Forge/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles/base.css",
    "./icons.css": "./styles/icons.css",
    "./icons.json": "./icons.json",
    "./tailwind-preset": "./tailwind-preset.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "!src/testing",
    "styles",
    "tailwind-preset.js",
    "icons.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "clsx": "^2.1.1",
    "react-router-dom": "^7.5.0",
    "@tanstack/react-query": "^5.74.4"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "clsx": "^2.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.5.0",
    "@tanstack/react-query": "^5.74.4"
  },
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {
    "@better-forge/contracts": "0.1.0"
  },
  "engines": {
    "node": ">=26.10.0"
  }
}
