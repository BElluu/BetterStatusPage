{
  "name": "@better-forge/mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol endpoint for a Fastify app: Bearer-only access, scoped tools, bounded and sanitised output.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BElluu/Better-Forge.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/BElluu/Better-Forge/tree/main/packages/mcp#readme",
  "bugs": {
    "url": "https://github.com/BElluu/Better-Forge/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@better-forge/contracts": "0.1.0"
  },
  "peerDependencies": {
    "fastify": "^5.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "fastify": "^5.3.2",
    "typescript": "^5.7.3",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=26.10.0"
  }
}
