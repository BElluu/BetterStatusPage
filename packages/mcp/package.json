{
  "name": "@better-kit/mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol endpoint for a Fastify app: Bearer-only access, scoped tools, bounded and sanitised output.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1"
  },
  "peerDependencies": {
    "@better-kit/contracts": "^0.1.0",
    "fastify": "^5.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "fastify": "^5.3.2",
    "typescript": "^5.7.3",
    "zod": "^4.4.3"
  }
}
