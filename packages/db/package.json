{
  "name": "@better-forge/db",
  "version": "0.1.0",
  "description": "SQLite (node:sqlite) and Drizzle bootstrap, transactions, schema and migration registries.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BElluu/Better-Forge.git",
    "directory": "packages/db"
  },
  "homepage": "https://github.com/BElluu/Better-Forge/tree/main/packages/db#readme",
  "bugs": {
    "url": "https://github.com/BElluu/Better-Forge/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/node": "*",
    "drizzle-orm": "^0.45.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=26.10.0"
  }
}
