---
import { REPO_URL, SITE_URL } from '../nav'
---

<header class="topbar">
  <div class="topbar-inner">
    <button class="icon-btn menu-btn" type="button" data-drawer-open aria-expanded="false" aria-controls="sidebar" aria-label="Open navigation">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </button>

    <a class="brand" href="/">
      <img src="/mark.svg" alt="" width="28" height="28" />
      <span class="brand-name">Better Status Page</span>
      <span class="brand-tag">Docs</span>
    </a>

    <button class="search-btn" type="button" data-search-open aria-label="Search the docs">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m20 20-4.2-4.2" /></svg>
      <span class="search-label">Search</span>
      <kbd>Ctrl K</kbd>
    </button>

    <nav class="topbar-links" aria-label="External">
      <a class="topbar-link" href={SITE_URL}>Website</a>
      <a class="topbar-link" href="https://demo.betterstatuspage.dev/">Demo</a>
      <a class="icon-btn" href={REPO_URL} aria-label="Source code on GitHub">
        <svg viewBox="0 0 24 24" aria-hidden="true" class="fill"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" /></svg>
      </a>
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Toggle dark mode">
        <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" /></svg>
      </button>
    </nav>
  </div>
</header>
