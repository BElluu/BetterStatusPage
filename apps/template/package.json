{
  "name": "@better-forge/template",
  "version": "0.1.0",
  "description": "A minimal application built only from the shared Better modules: setup, sign-in, users, API tokens, audit log, vault, notifications and backups.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "tsc -p tsconfig.json && vite build --config web/vite.config.ts",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "@better-forge/audit": "*",
    "@better-forge/auth": "*",
    "@better-forge/backup": "*",
    "@better-forge/config-as-code": "*",
    "@better-forge/contracts": "*",
    "@better-forge/db": "*",
    "@better-forge/notify": "*",
    "@better-forge/runtime": "*",
    "@better-forge/ui": "*",
    "@better-forge/vault": "*",
    "@fastify/cookie": "^11.1.1",
    "@fastify/cors": "^10.0.2",
    "@fastify/jwt": "^10.1.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.3",
    "@tanstack/react-query": "^5.74.4",
    "clsx": "^2.1.1",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.5.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "vite": "^6.2.5"
  }
}
